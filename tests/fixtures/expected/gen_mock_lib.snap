//! mockmcp — Dekopon provider generated from http://127.0.0.1:PORT.
//!
//! Generated by mcp2dekopon 0.2.0 from mock-mcp 0.0.0 (http://127.0.0.1:PORT/mcp) for
//! dekopon-provider-sdk =0.46.1. DO NOT EDIT; regenerate with
//! `mcp2dekopon gen --url http://127.0.0.1:PORT/mcp --id mockmcp --out <dir>`.

use dekopon_provider_sdk::clap::{Args, Parser, Subcommand};
use dekopon_provider_sdk::provider::{
    endpoint::Base, method, Capability, Code, Failure, Header, Http, HttpBuildError, HttpError,
    Proposal, Provider, Request, Response, Settings, Stdout, Usage,
};
use dekopon_provider_sdk::{EffectKind, RiskLevel};
use schemars::JsonSchema;
use serde::{Deserialize, Serialize};
use serde_json::{json, Value};
use std::io::Write;

/// MCP protocol version offered in `initialize`.
const MCP_PROTOCOL_VERSION: &str = "2025-06-18";
/// The MCP endpoint this provider was generated from; the operator may
/// override it per deployment with `providerSettings.mockmcp.baseUrl`.
const VENDOR_BASE: Base = Base::from_static("http://127.0.0.1:PORT/mcp");

/// Operator settings: `providerSettings.mockmcp` in the broker configuration.
/// Unknown keys are ignored so older providers keep working as the
/// broker configuration grows.
#[derive(Debug, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct McpSettings {
    base_url: Option<Base>,
}

/// Client identity sent in `initialize`.
const CLIENT_NAME: &str = "mockmcp";
const CLIENT_VERSION: &str = "0.2.0";

/// Every way an MCP call can fail.
#[derive(Debug)]
pub enum McpError {
    InvalidRequest(HttpBuildError),
    Http(HttpError),
    HttpStatus(u16),
    Protocol(String),
    Rpc {
        code: i64,
        message: String,
    },
    ToolFailed,
    Encoding,
    Output,
    #[allow(dead_code)]
    InvalidArguments(&'static str),
}

impl std::fmt::Display for McpError {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::InvalidRequest(error) => write!(formatter, "{error}"),
            Self::Http(error) => write!(formatter, "{error}"),
            Self::HttpStatus(status) => write!(formatter, "mcp server returned status {status}"),
            Self::Protocol(message) => formatter.write_str(message),
            Self::Rpc { code, message } => write!(formatter, "mcp error {code}: {message}"),
            Self::ToolFailed => formatter.write_str("the tool reported an error"),
            Self::Encoding => formatter.write_str("the provider could not encode its input"),
            Self::Output => formatter.write_str("provider stdout closed"),
            Self::InvalidArguments(field) => write!(formatter, "argument {field:?} must be JSON"),
        }
    }
}

impl Failure for McpError {
    fn code(&self) -> Code {
        Code::new(match self {
            Self::InvalidRequest(_) => "invalid-request",
            Self::Http(_) => "http-failed",
            Self::HttpStatus(_) => "bad-status",
            Self::Protocol(_) => "protocol-error",
            Self::Rpc { .. } => "rpc-error",
            Self::ToolFailed => "tool-failed",
            Self::Encoding => "encoding-failed",
            Self::Output => "output-error",
            Self::InvalidArguments(_) => "invalid-arguments",
        })
    }
}

fn ht(name: &'static str, value: &str) -> Result<Header, McpError> {
    Header::text(name, value).map_err(McpError::InvalidRequest)
}

fn hb(name: &'static str, value: Vec<u8>) -> Result<Header, McpError> {
    Header::new(name, value).map_err(McpError::InvalidRequest)
}

fn header_bytes<'a>(response: &'a Response, name: &str) -> Option<&'a [u8]> {
    response
        .headers
        .iter()
        .find(|header| header.name.eq_ignore_ascii_case(name))
        .map(|header| header.value.as_slice())
}

fn content_type_of(response: &Response) -> Option<&str> {
    header_bytes(response, "content-type").and_then(|value| std::str::from_utf8(value).ok())
}

/// The first 120 characters of a body, for error messages.
fn snippet(text: &str) -> String {
    if text.chars().count() <= 120 {
        return text.to_string();
    }
    let mut short: String = text.chars().take(120).collect();
    short.push_str("...");
    short
}

/// Parses one response body: plain JSON, or the buffered SSE event carrying
/// the JSON-RPC message.
fn parse_rpc_body(body: &[u8], content_type: Option<&str>) -> Result<Value, McpError> {
    let text = std::str::from_utf8(body)
        .map_err(|_| McpError::Protocol("response body was not UTF-8".to_string()))?;
    let looks_sse = content_type
        .is_some_and(|kind| kind.to_ascii_lowercase().contains("text/event-stream"))
        || text.trim_start().starts_with("data:")
        || text.trim_start().starts_with("event:");
    let not_json = || McpError::Protocol(format!("response body was not JSON: {}", snippet(text)));
    if looks_sse {
        sse_json(text).or_else(|_| serde_json::from_str(text).map_err(|_| not_json()))
    } else {
        serde_json::from_str(text).map_err(|_| not_json())
    }
}

/// Extracts the last data payload that looks like a JSON-RPC response.
fn sse_json(text: &str) -> Result<Value, McpError> {
    let mut payloads: Vec<String> = Vec::new();
    let mut data: Vec<&str> = Vec::new();
    for raw_line in text.split('\n') {
        let line = raw_line.strip_suffix('\r').unwrap_or(raw_line);
        if line.is_empty() {
            if !data.is_empty() {
                payloads.push(data.join("\n"));
                data.clear();
            }
            continue;
        }
        if line.starts_with(':') {
            continue;
        }
        if let Some(rest) = line.strip_prefix("data:") {
            data.push(rest.strip_prefix(' ').unwrap_or(rest));
        }
    }
    if !data.is_empty() {
        payloads.push(data.join("\n"));
    }
    for payload in payloads.iter().rev() {
        if let Ok(Value::Object(map)) = serde_json::from_str::<Value>(payload) {
            if map.contains_key("result") || map.contains_key("error") {
                return Ok(Value::Object(map));
            }
        }
    }
    Err(McpError::Protocol(format!(
        "no JSON-RPC message in SSE response: {}",
        snippet(text)
    )))
}

/// Splits a JSON-RPC message into its result or its error.
fn rpc_result(payload: &Value) -> Result<&Value, McpError> {
    if let Some(error) = payload.get("error") {
        let code = error.get("code").and_then(Value::as_i64).unwrap_or(0);
        let message = error
            .get("message")
            .and_then(Value::as_str)
            .unwrap_or("mcp error")
            .to_owned();
        return Err(McpError::Rpc { code, message });
    }
    payload
        .get("result")
        .filter(|result| result.is_object())
        .ok_or_else(|| McpError::Protocol("JSON-RPC response had no result".to_string()))
}

/// Reads the negotiated protocol version from an `initialize` answer, if any.
fn init_protocol(response: &Response) -> Option<String> {
    let payload = parse_rpc_body(&response.body, content_type_of(response)).ok()?;
    let result = rpc_result(&payload).ok()?;
    result
        .get("protocolVersion")
        .and_then(Value::as_str)
        .map(str::to_owned)
}

/// Runs one MCP round trip against `base`: `initialize`, the
/// `notifications/initialized` notice (best effort), then `tools/call`
/// for `tool`, printing the MCP `content` as one JSON line.
fn call_mcp(
    http: &Http,
    base: &Base,
    tool: &'static str,
    arguments: Value,
    out: &mut Stdout,
) -> Result<(), McpError> {
    let url = base.as_str().to_owned();
    let initialize = json!({
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
            "protocolVersion": MCP_PROTOCOL_VERSION,
            "capabilities": {},
            "clientInfo": {"name": CLIENT_NAME, "version": CLIENT_VERSION},
        },
    });
    let init_request = Request::new(method::POST, &url)
        .map_err(McpError::InvalidRequest)?
        .with_header(ht("content-type", "application/json")?)
        .with_header(ht("accept", "application/json, text/event-stream")?)
        .with_body(initialize.to_string().into_bytes());
    let init_response = http.send(init_request).map_err(McpError::Http)?;
    if !(200..300).contains(&init_response.status) {
        return Err(McpError::HttpStatus(init_response.status));
    }
    let session = header_bytes(&init_response, "mcp-session-id").map(<[u8]>::to_vec);
    let protocol = init_protocol(&init_response).unwrap_or_else(|| MCP_PROTOCOL_VERSION.to_owned());
    // Best effort: some servers require the notice before `tools/call`,
    // others reject it; either way the call proceeds.
    let notice = json!({"jsonrpc": "2.0", "method": "notifications/initialized"});
    let notice_request = (|| -> Result<Request, McpError> {
        let mut request = Request::new(method::POST, &url)
            .map_err(McpError::InvalidRequest)?
            .with_header(ht("content-type", "application/json")?)
            .with_header(ht("accept", "application/json, text/event-stream")?)
            .with_header(ht("mcp-protocol-version", &protocol)?);
        if let Some(session) = &session {
            request = request.with_header(hb("mcp-session-id", session.clone())?);
        }
        Ok(request.with_body(notice.to_string().into_bytes()))
    })();
    if let Ok(notice_request) = notice_request {
        let _ignored = http.send(notice_request);
    }
    let call = json!({
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/call",
        "params": {"name": tool, "arguments": arguments},
    });
    let mut call_request = Request::new(method::POST, &url)
        .map_err(McpError::InvalidRequest)?
        .with_header(ht("content-type", "application/json")?)
        .with_header(ht("accept", "application/json, text/event-stream")?)
        .with_header(ht("mcp-protocol-version", &protocol)?);
    if let Some(session) = session {
        call_request = call_request.with_header(hb("mcp-session-id", session)?);
    }
    let call_request = call_request.with_body(call.to_string().into_bytes());
    let call_response = http.send(call_request).map_err(McpError::Http)?;
    if !(200..300).contains(&call_response.status) {
        return Err(McpError::HttpStatus(call_response.status));
    }
    let payload = parse_rpc_body(&call_response.body, content_type_of(&call_response))?;
    if payload.get("id") != Some(&json!(2)) {
        let got = payload
            .get("id")
            .map_or_else(|| "missing".to_string(), Value::to_string);
        return Err(McpError::Protocol(format!(
            "response id {got} did not match request 2"
        )));
    }
    let result = rpc_result(&payload)?;
    let content = result.get("content").unwrap_or(result);
    let line = serde_json::to_string(content).map_err(|_| McpError::Encoding)?;
    writeln!(out, "{line}").map_err(|_| McpError::Output)?;
    if result
        .get("isError")
        .and_then(Value::as_bool)
        .unwrap_or(false)
    {
        return Err(McpError::ToolFailed);
    }
    Ok(())
}

/// Parses free-map fields from JSON text in place; arrays are descended so
/// maps nested under lists are parsed too.
fn parse_json_field_path(value: &mut Value, path: &[&'static str]) -> Result<(), McpError> {
    let Some((head, tail)) = path.split_first() else {
        return Ok(());
    };
    match value {
        Value::Object(map) => match map.get_mut(*head) {
            None => Ok(()),
            Some(next) if tail.is_empty() => {
                if let Value::String(text) = next {
                    let parsed: Value =
                        serde_json::from_str(text).map_err(|_| McpError::InvalidArguments(head))?;
                    *next = parsed;
                }
                Ok(())
            }
            Some(next) => parse_json_field_path(next, tail),
        },
        Value::Array(items) => {
            for item in items {
                parse_json_field_path(item, path)?;
            }
            Ok(())
        }
        _ => Ok(()),
    }
}

