}

/// mockmcp — MCP tools from http://127.0.0.1:PORT.
#[derive(Debug, Parser)]
#[command(name = "mockmcp", version = "0.1.0", subcommand_required = true)]
pub struct Command {
    #[command(subcommand)]
    action: Action,
}

#[derive(Debug, Subcommand)]
pub enum Action {
    /// Search the mock index.
    #[command(name = "search")]
    Search(SearchArgs),
    /// Fetch one record with options.
    #[command(name = "get_details")]
    GetDetails(GetDetailsArgs),
    /// Locate a repo or a gist.
    #[command(name = "locate")]
    Locate(LocateArgs),
    /// Takes a value or a list of values.
    #[command(name = "either")]
    Either(EitherArgs),
    /// Takes free-form arguments.
    #[command(name = "remap")]
    Remap(RemapArgs),
}

fn parse_arg<T: serde::de::DeserializeOwned>(
    tool: &'static str,
    flag: &'static str,
    raw: Option<String>,
) -> Result<Option<T>, Usage> {
    raw.map(|text| {
        serde_json::from_str(&text)
            .map_err(|_| Usage::new(format!("{tool}: --{flag} must be JSON")))
    })
    .transpose()
}

fn parse_required_arg<T: serde::de::DeserializeOwned>(
    tool: &'static str,
    flag: &'static str,
    raw: String,
) -> Result<T, Usage> {
    serde_json::from_str(&raw).map_err(|_| Usage::new(format!("{tool}: --{flag} must be JSON")))
}

impl Capability for SearchCap {
    type Provider = McpProvider;
    const NAME: &'static str = "search";
    const DESCRIPTION: &'static str = "Search the mock index.";
    const EFFECT: EffectKind = EffectKind::ReadOnly;
    const RISK: RiskLevel = RiskLevel::Low;
    type Input = SearchInput;
    type Needs = (Settings<McpSettings>, Http);
    type Error = McpError;

    fn run(
        input: SearchInput,
        (settings, http): (Settings<McpSettings>, Http),
        out: &mut Stdout,
    ) -> Result<(), McpError> {
        let base = settings
            .into_inner()
            .base_url
            .unwrap_or_else(|| VENDOR_BASE.clone());
        let arguments = serde_json::to_value(&input).map_err(|_| McpError::Encoding)?;
        call_mcp(&http, &base, "search", arguments, out)
    }
}

impl Capability for GetDetailsCap {
    type Provider = McpProvider;
    const NAME: &'static str = "get_details";
    const DESCRIPTION: &'static str = "Fetch one record with options.";
    const EFFECT: EffectKind = EffectKind::ExternalWrite;
    const RISK: RiskLevel = RiskLevel::Medium;
    type Input = GetDetailsInput;
    type Needs = (Settings<McpSettings>, Http);
    type Error = McpError;

    fn run(
        input: GetDetailsInput,
        (settings, http): (Settings<McpSettings>, Http),
        out: &mut Stdout,
    ) -> Result<(), McpError> {
        let base = settings
            .into_inner()
            .base_url
            .unwrap_or_else(|| VENDOR_BASE.clone());
        let mut arguments = serde_json::to_value(&input).map_err(|_| McpError::Encoding)?;
        parse_json_field_path(&mut arguments, &["options", "labels"])?;
        call_mcp(&http, &base, "get_details", arguments, out)
    }
}

