impl Capability for RemapCap {
    type Provider = McpProvider;
    const NAME: &'static str = "remap";
    const DESCRIPTION: &'static str = "Takes free-form arguments.";
    const EFFECT: EffectKind = EffectKind::ExternalWrite;
    const RISK: RiskLevel = RiskLevel::Medium;
    type Input = RemapInput;
    type Needs = (Settings<McpSettings>, Http);
    type Error = McpError;

    fn run(
        input: RemapInput,
        (settings, http): (Settings<McpSettings>, Http),
        out: &mut Stdout,
    ) -> Result<(), McpError> {
        let base = settings
            .into_inner()
            .base_url
            .unwrap_or_else(|| VENDOR_BASE.clone());
        let arguments: Value = serde_json::from_str(&input.payload)
            .map_err(|_| McpError::InvalidArguments("payload"))?;
        if !arguments.is_object() {
            return Err(McpError::InvalidArguments("payload"));
        }
        call_mcp(&http, &base, "remap", arguments, out)
    }
}

/// The generated provider: MCP tools from one endpoint.
pub struct McpProvider;

impl Provider for McpProvider {
    const ID: &'static str = "mockmcp";
    const COMMAND_WORDS: &'static [&'static str] = &["mockmcp"];
    const DESCRIPTION: &'static str = "MCP tools from http://127.0.0.1:PORT (mock-mcp 0.0.0)";
    type Args = Command;
    #[rustfmt::skip]
    type Capabilities = (SearchCap, GetDetailsCap, LocateCap, EitherCap, RemapCap);
    #[rustfmt::skip]
    fn propose(args: Command, _stdin_piped: bool) -> Result<Proposal<Self>, Usage> {
        match args.action {
            Action::Search(args) => Ok(Proposal::to::<SearchCap>(SearchInput {
                limit: args.limit,
                query: args.query,
                sort: args.sort,
            })),
            Action::GetDetails(args) => Ok(Proposal::to::<GetDetailsCap>(GetDetailsInput {
                key: args.key,
                options: parse_arg::<GetDetailsOptions>("get_details", "options", args.options)?,
            })),
            Action::Locate(args) => Ok(Proposal::to::<LocateCap>(LocateInput {
                target: parse_required_arg::<LocateTargetValue>("locate", "target", args.target)?,
            })),
            Action::Either(args) => Ok(Proposal::to::<EitherCap>(EitherInput {
                value: parse_arg::<EitherValueValue>("either", "value", args.value)?,
            })),
            Action::Remap(args) => Ok(Proposal::to::<RemapCap>(RemapInput {
                payload: args.payload,
            })),
        }
    }
}

dekopon_provider_sdk::export!(McpProvider);
