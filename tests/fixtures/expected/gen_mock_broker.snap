# Starter broker fragment for provider `mockmcp`, generated by mcp2dekopon 0.1.0
# from http://127.0.0.1:PORT/mcp (mock-mcp 0.0.0).
#
# Install: copy this file into your broker.d/ directory and add a policy to a
# `*.cedar` file (see ../mockmcp.cedar). Every capability below may POST only to
# http://127.0.0.1:PORT, at most twice per call (initialize plus tools/call).
#
# Review the effect labels in ../report.json before granting anything: a wrong
# `read-only` would place a capability in the provider's `read-only` group.
#
# The provider posts to its vendor default (http://127.0.0.1:PORT/mcp); to point a
# deployment elsewhere, add a commented-style override to another fragment:
#
# providerSettings:
#   mockmcp:
#     baseUrl: http://127.0.0.1:PORT/mcp
capabilities:
  mockmcp:
    capabilities:
      mockmcp.search:
        # credential: <name-in-broker-credentials.yaml>  # uncomment when the MCP server needs auth
        constraints:
          timeoutMs: 30000
          http:
            allowedHosts: [127.0.0.1:PORT]
            allowedMethods: [POST]
            maxRequests: 2
            maxRequestBytes: 65536
            maxResponseBytes: 1048576
            allowPlaintextLoopback: true
      mockmcp.get_details:
        # credential: <name-in-broker-credentials.yaml>  # uncomment when the MCP server needs auth
        constraints:
          timeoutMs: 30000
          http:
            allowedHosts: [127.0.0.1:PORT]
            allowedMethods: [POST]
            maxRequests: 2
            maxRequestBytes: 65536
            maxResponseBytes: 1048576
            allowPlaintextLoopback: true
      mockmcp.locate:
        # credential: <name-in-broker-credentials.yaml>  # uncomment when the MCP server needs auth
        constraints:
          timeoutMs: 30000
          http:
            allowedHosts: [127.0.0.1:PORT]
            allowedMethods: [POST]
            maxRequests: 2
            maxRequestBytes: 65536
            maxResponseBytes: 1048576
            allowPlaintextLoopback: true
      mockmcp.either:
        # credential: <name-in-broker-credentials.yaml>  # uncomment when the MCP server needs auth
        constraints:
          timeoutMs: 30000
          http:
            allowedHosts: [127.0.0.1:PORT]
            allowedMethods: [POST]
            maxRequests: 2
            maxRequestBytes: 65536
            maxResponseBytes: 1048576
            allowPlaintextLoopback: true
      mockmcp.remap:
        # credential: <name-in-broker-credentials.yaml>  # uncomment when the MCP server needs auth
        constraints:
          timeoutMs: 30000
          http:
            allowedHosts: [127.0.0.1:PORT]
            allowedMethods: [POST]
            maxRequests: 2
            maxRequestBytes: 65536
            maxResponseBytes: 1048576
            allowPlaintextLoopback: true
